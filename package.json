{
  "name": "bulk-typography-style-editor",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run typecheck && npm run build:controller && npm run build:ui",
    "build:controller": "node scripts/build-controller.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "test": "npm run test:unit && node src/ui-smoke-check.mjs && node src/build-drift-check.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "watch:ui": "tailwindcss -i src/ui/styles.css -o .tmp/ui.css --watch"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.97.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  }
}
